          "id": "spec001:DIALOGUE-workshop-menu",
          "speakerId": "narrator",
          "text": "Identify the bench-checked endpoints and ordered path on the relief table. The hypothesis board accepts a nonempty testable possibility in your own words: identify what may be wrong and an observation that could support or challenge it. Pinning stores speculation separately from observations. No secret phrase or agreement with the author is required.",
          "condition": {
            "kind": "always"
          },
          "choices": [
            {
              "id": "spec001:ACTION-endpoints",
              "text": "Identify known-good endpoints",
              "condition": {
                "kind": "always"
              },
              "nextNodeId": null,
              "effects": [
                {
                  "kind": "record-fact",
                  "effectId": "spec001:EFFECT-endpoints",
                  "factId": "spec001:FACT-endpoints"
                },
                {
                  "kind": "record-fact",
                  "effectId": "spec001:EFFECT-endpoint-a",
                  "factId": "spec001:FACT-endpoint-a"
                },
                {
                  "kind": "record-fact",
                  "effectId": "spec001:EFFECT-endpoint-b",
                  "factId": "spec001:FACT-endpoint-b"
                },
                {
                  "kind": "set-flag",
                  "effectId": "spec001:EFFECT-endpoints-identified",
                  "flagId": "spec001:FLAG-endpoints-identified",
                  "value": true
                }
              ]
            },
            {
              "id": "spec001:ACTION-declare-path",
