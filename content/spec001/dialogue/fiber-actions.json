              "condition": {
                "kind": "always"
              },
              "nextNodeId": null,
              "effects": [
                {
                  "kind": "record-fact",
                  "effectId": "spec001:EFFECT-fiber-read-matching",
                  "factId": "spec001:FACT-O05-matching"
                }
              ]
            },
