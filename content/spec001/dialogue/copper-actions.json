              "condition": {
                "kind": "always"
              },
              "nextNodeId": null,
              "effects": [
                {
                  "kind": "record-fact",
                  "effectId": "spec001:EFFECT-copper-read-defect",
                  "factId": "spec001:FACT-O03-defect"
