          "speakerId": "narrator",
          "text": "The original broken 105 m test path is selected when you first arrive. Read the cards, inspect before changing it, then choose either supplied repair. You may restore the original test section and try again at any time. Selecting a path changes the bench; it does not take a measurement or complete the investigation. The kit stays in your inventory.",
          "condition": {
            "kind": "objective-complete",
            "objectiveId": "spec001:O02"
          },
          "choices": [
            {
              "id": "spec001:ACTION-copper-read-compatibility",
              "text": "Read and keep the supplied compatibility card",
              "condition": {
                "kind": "always"
              },
              "nextNodeId": null,
              "effects": [
                {
                  "kind": "record-fact",
                  "effectId": "spec001:EFFECT-copper-read-compatibility",
                  "factId": "spec001:FACT-O03-compatibility"
                }
              ]
            },
            {
              "id": "spec001:ACTION-copper-read-defect",
