                "kind": "always"
              },
              "nextNodeId": null,
              "effects": []
            },
            {
              "id": "spec001:ACTION-market-assemble-A",
              "text": "Join the module and lead from your selected tray. Kit A serves the supplied 12 W and 11 W endpoints. Validate it at the ledger.",
              "condition": {
                "kind": "flag-equals",
                "flagId": "spec001:FLAG-market-kit",
                "value": "compatible-kit-A"
              },
              "nextNodeId": null,
              "effects": []
            },
            {
              "id": "spec001:ACTION-market-assemble-B",
              "text": "Join the module and lead from your selected tray. Kit B serves the supplied 12 W, 11 W and 7 W endpoints. Validate it at the ledger.",
              "condition": {
                "kind": "flag-equals",
                "flagId": "spec001:FLAG-market-kit",
                "value": "compatible-kit-B"
              },
