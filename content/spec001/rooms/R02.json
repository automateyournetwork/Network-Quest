    {
      "id": "spec001:HOTSPOT-hypothesis",
      "subjectId": "spec001:PR018",
      "label": "Hypothesis board",
      "description": "Pin your own testable idea after identifying the endpoints and path. Try stating what may explain the symptom and how an inspection could challenge it. The board is for speculation, not awarded facts.",
      "verbs": [
        "look",
        "use"
      ],
      "unsupportedVerbText": "The board cannot invent your idea. Open Hypotheses in the notebook, write a testable possibility in your own words, and use Pin hypothesis. No exact phrase is required.",
      "evidenceIds": [],
      "actionIds": [
        "spec001:ACTION-pin-hypothesis"
      ]
    },
    {
      "id": "spec001:HOTSPOT-routes",
      "subjectId": "spec001:PR016",
      "label": "Investigation routes",
      "description": "The easel has three equally sized routes: Copper Warrens and Echo Cavern; Photon Gardens and Prism Vault; Skywell and Storm Observatory. Choose any one after O02. The Shell Market and Clockworks are shared preparation. Completing other branches is optional.",
