  {
    "assetId": "spec001:ASSET-VOICE-019",
    "roomId": "spec001:R02",
    "exportPath": "public/assets/audio/auditions/titan-019.mp3",
    "channel": "voice",
    "label": "Titan — tutorial 019",
    "text": "Bring me an observation, a question, and a willingness to change your mind. The enormous hammer is optional.",
