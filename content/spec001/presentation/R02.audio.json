    "trigger": "inspect-stale",
    "captionId": "spec001:DIALOGUE-VOICE-027"
  },
  {
    "assetId": "spec001:ASSET-VOICE-028",
    "roomId": "spec001:R02",
    "exportPath": "public/assets/audio/voices/voice-028.mp3",
