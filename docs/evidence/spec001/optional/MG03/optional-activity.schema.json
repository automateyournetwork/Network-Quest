{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-quest.example/proposals/optional-channel-scout.schema.json",
  "$comment": "Copyright 2026 John Capobianco. SPDX-License-Identifier: Apache-2.0. Isolated candidate, not active runtime schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "speakerId",
    "instructions",
    "profileId",
    "delivery",
    "selectionActions",
    "practice",
    "feedback",
    "controls",
    "recovery",
    "reward",
    "entryContexts",
    "returnPolicy",
    "timingDefault"
  ],
  "properties": {
    "kind": {
      "const": "radio-channel-scout"
    },
    "speakerId": {
      "const": "spec001:CH10"
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "profileId": {
      "const": "spec001:PROFILE-RADIO"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "sourceCaseIds",
        "measurementObjectiveId",
        "measurementRuleId",
        "measurementRoomId",
        "predictionRequired",
        "measurementAfterPrediction",
        "historicalUse",
        "currentRequired"
      ],
      "properties": {
        "actionId": {
          "const": "spec001:ACTION-MG03-compare"
        },
        "sourceCaseIds": {
          "const": [
            "T08",
            "T09",
            "B-RADIO-20",
            "T13",
            "C-FRESH",
            "B-STALE-FLAG"
          ]
        },
        "measurementObjectiveId": {
          "const": "spec001:O08"
        },
        "measurementRuleId": {
          "const": "spec001:PHY07"
        },
        "measurementRoomId": {
          "const": "spec001:R08"
        },
        "predictionRequired": {
          "const": true
        },
        "measurementAfterPrediction": {
          "const": true
        },
        "historicalUse": {
          "const": "comparison-only"
        },
        "currentRequired": {
          "const": true
        }
      }
    },
    "selectionActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel-A",
        "channel-B",
        "mitigate-emitter",
        "raise-noise"
      ],
      "properties": {
        "channel-A": {
          "const": "spec001:ACTION-radio-channel-A"
        },
        "channel-B": {
          "const": "spec001:ACTION-radio-channel-B"
        },
        "mitigate-emitter": {
          "const": "spec001:ACTION-radio-mitigate-emitter"
        },
        "raise-noise": {
          "const": "spec001:ACTION-radio-raise-noise"
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCaseId",
        "signal",
        "noise",
        "viablePath",
        "settingsCompatible",
        "explanation"
      ],
      "properties": {
        "sourceCaseId": {
          "const": "B-RADIO-20"
        },
        "signal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "const": -65
            },
            "unit": {
              "const": "dBm"
            }
          }
        },
        "noise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "const": -85
            },
            "unit": {
              "const": "dBm"
            }
          }
        },
        "viablePath": {
          "const": true
        },
        "settingsCompatible": {
          "const": true
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missingEvidence",
        "freshMeasurementRequired",
        "predictionRecorded",
        "incorrect",
        "correct",
        "contentError",
        "alreadyCompleted"
      ],
      "properties": {
        "missingEvidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "freshMeasurementRequired": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "predictionRecorded": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "incorrect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "correct": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "contentError": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "alreadyCompleted": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "practice",
        "delivery",
        "predict",
        "measure",
        "submit",
        "retry",
        "exit"
      ],
      "properties": {
        "practice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "delivery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "predict": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "measure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "submit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "exit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retryExplanation",
        "exitExplanation"
      ],
      "properties": {
        "retryExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "exitExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "factId"
      ],
      "properties": {
        "kind": {
          "const": "optional-radio-practice"
        },
        "factId": {
          "const": "spec001:FACT-MG03-completion"
        }
      }
    },
    "entryContexts": {
      "const": [
        {
          "roomId": "spec001:R08",
          "safePositionId": "spec001:R08.entry",
          "hotspotId": "spec001:HOTSPOT-radio-channels"
        }
      ]
    },
    "returnPolicy": {
      "const": "captured-entry"
    },
    "timingDefault": {
      "const": "off"
    }
  }
}
