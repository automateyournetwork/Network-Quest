{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-quest.example/proposals/optical-budget-bench.schema.json",
  "$comment": "Copyright 2026 John Capobianco. SPDX-License-Identifier: Apache-2.0. Isolated T102 proposal only; not an active shared schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "speakerId",
    "instructions",
    "profileId",
    "practice",
    "delivery",
    "boundaryExample",
    "compatibilityCards",
    "answerControls",
    "feedback",
    "controls",
    "recovery",
    "reward",
    "entryContexts",
    "returnPolicy",
    "timingDefault"
  ],
  "properties": {
    "kind": {
      "const": "optical-budget-bench"
    },
    "speakerId": {
      "const": "spec001:CH16"
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      }
    },
    "profileId": {
      "const": "spec001:PROFILE-OPTICAL"
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCaseId",
        "compatible",
        "loss",
        "explanation"
      ],
      "properties": {
        "sourceCaseId": {
          "const": "T04"
        },
        "compatible": {
          "const": true
        },
        "loss": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "const": 8
            },
            "unit": {
              "const": "dB"
            }
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCaseId",
        "compatible",
        "loss",
        "actionId"
      ],
      "properties": {
        "sourceCaseId": {
          "const": "T05"
        },
        "compatible": {
          "const": true
        },
        "loss": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "const": 10
            },
            "unit": {
              "const": "dB"
            }
          }
        },
        "actionId": {
          "const": "spec001:ACTION-MG02-diagnose"
        }
      }
    },
    "boundaryExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCaseId",
        "compatible",
        "loss",
        "explanation"
      ],
      "properties": {
        "sourceCaseId": {
          "const": "T15"
        },
        "compatible": {
          "const": true
        },
        "loss": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "const": 9
            },
            "unit": {
              "const": "dB"
            }
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      }
    },
    "compatibilityCards": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceCaseId",
            "premises",
            "explanation"
          ],
          "properties": {
            "sourceCaseId": {
              "const": "C-COMPAT"
            },
            "premises": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "knownProfiles",
                "everyRequiredCompatibilityCheck",
                "requiredInspectionComplete"
              ],
              "properties": {
                "knownProfiles": {
                  "const": true
                },
                "everyRequiredCompatibilityCheck": {
                  "const": true
                },
                "requiredInspectionComplete": {
                  "const": true
                }
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceCaseId",
            "premises",
            "explanation"
          ],
          "properties": {
            "sourceCaseId": {
              "const": "T07"
            },
            "premises": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "knownProfiles",
                "compatible",
                "nominalOpticalBudgetSufficient"
              ],
              "properties": {
                "knownProfiles": {
                  "const": true
                },
                "compatible": {
                  "const": false
                },
                "nominalOpticalBudgetSufficient": {
                  "const": true
                }
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceCaseId",
            "premises",
            "explanation"
          ],
          "properties": {
            "sourceCaseId": {
              "const": "B-COMPAT"
            },
            "premises": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "knownProfiles",
                "sameConnectorShape",
                "requiredWavelengthDirectionMatches",
                "numericBudgetSufficient"
              ],
              "properties": {
                "knownProfiles": {
                  "const": true
                },
                "sameConnectorShape": {
                  "const": true
                },
                "requiredWavelengthDirectionMatches": {
                  "const": false
                },
                "numericBudgetSufficient": {
                  "const": true
                }
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            }
          }
        }
      ],
      "items": false
    },
    "answerControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiveLabel",
        "marginLabel",
        "reserveLabel",
        "reserveMet",
        "reserveShortfall",
        "overloadLabel",
        "overloaded",
        "notOverloaded"
      ],
      "properties": {
        "receiveLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "marginLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "reserveLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "reserveMet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "reserveShortfall": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "overloadLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "overloaded": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "notOverloaded": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "practice",
        "delivery",
        "contentError",
        "alreadyCompleted"
      ],
      "properties": {
        "practice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correct",
            "incorrect",
            "invalidInput"
          ],
          "properties": {
            "correct": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "incorrect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "invalidInput": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correct",
            "incorrect",
            "invalidInput"
          ],
          "properties": {
            "correct": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "incorrect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "invalidInput": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            }
          }
        },
        "contentError": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "alreadyCompleted": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "practice",
        "delivery",
        "submit",
        "retry",
        "exit"
      ],
      "properties": {
        "practice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "delivery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "submit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "retry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "exit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retryExplanation",
        "exitExplanation"
      ],
      "properties": {
        "retryExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "exitExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "factId"
      ],
      "properties": {
        "kind": {
          "const": "optional-optical-depth"
        },
        "factId": {
          "const": "spec001:FACT-MG02-completion"
        }
      }
    },
    "entryContexts": {
      "const": [
        {
          "roomId": "spec001:R06",
          "safePositionId": "spec001:R06.entry",
          "hotspotId": "spec001:HOTSPOT-fiber-r06-pr059"
        }
      ]
    },
    "returnPolicy": {
      "const": "captured-entry"
    },
    "timingDefault": {
      "const": "off"
    }
  }
}
