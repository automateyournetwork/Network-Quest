{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "speakerId",
    "profileId",
    "instructions",
    "practice",
    "delivery",
    "answerControls",
    "feedback",
    "controls",
    "recovery",
    "reward",
    "entryContexts",
    "returnPolicy",
    "timingDefault"
  ],
  "properties": {
    "kind": {
      "const": "radio-weather-diary"
    },
    "speakerId": {
      "const": "spec001:CH10"
    },
    "profileId": {
      "const": "spec001:PROFILE-RADIO"
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCaseId",
        "signal",
        "noise",
        "otherPathChecks",
        "explanation"
      ],
      "properties": {
        "sourceCaseId": {
          "const": "B-RADIO-20"
        },
        "signal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "const": -65
            },
            "unit": {
              "const": "dBm"
            }
          }
        },
        "noise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "const": -85
            },
            "unit": {
              "const": "dBm"
            }
          }
        },
        "otherPathChecks": {
          "const": true
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "sourceCaseIds",
        "measurementObjectiveId",
        "measurementRuleId",
        "measurementRoomId",
        "historicalUse",
        "currentRequired",
        "order"
      ],
      "properties": {
        "actionId": {
          "const": "spec001:ACTION-SQ03-compare"
        },
        "sourceCaseIds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "const": "T08"
            },
            {
              "const": "T09"
            },
            {
              "const": "B-RADIO-20"
            },
            {
              "const": "B-RADIO-BELOW"
            }
          ]
        },
        "measurementObjectiveId": {
          "const": "spec001:O08"
        },
        "measurementRuleId": {
          "const": "spec001:PHY07"
        },
        "measurementRoomId": {
          "const": "spec001:R08"
        },
        "historicalUse": {
          "const": "comparison-only"
        },
        "currentRequired": {
          "const": true
        },
        "order": {
          "const": "strictly-increasing-configuration-revision"
        }
      }
    },
    "answerControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earlierLabel",
        "laterLabel",
        "comparisonLabel",
        "increased",
        "unchanged",
        "decreased",
        "assessmentLabel",
        "meetsThreshold",
        "belowThreshold",
        "claimLabel",
        "currentOnly",
        "historicalProof",
        "weatherCause",
        "throughputProof"
      ],
      "properties": {
        "earlierLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "laterLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "comparisonLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "increased": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "unchanged": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "decreased": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "assessmentLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "meetsThreshold": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "belowThreshold": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "claimLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "currentOnly": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "historicalProof": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "weatherCause": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "throughputProof": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "practice",
        "delivery",
        "missingEvidence",
        "contentError",
        "alreadyCompleted"
      ],
      "properties": {
        "practice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correct",
            "incorrect",
            "invalidInput"
          ],
          "properties": {
            "correct": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "incorrect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "invalidInput": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correct",
            "incorrect",
            "invalidInput"
          ],
          "properties": {
            "correct": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "incorrect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "invalidInput": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "missingEvidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "contentError": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "alreadyCompleted": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "practice",
        "delivery",
        "submit",
        "retry",
        "exit"
      ],
      "properties": {
        "practice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "delivery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "submit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "exit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retryExplanation",
        "exitExplanation"
      ],
      "properties": {
        "retryExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "exitExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "factId",
        "assetId",
        "title",
        "paragraphs",
        "alternativeText",
        "unavailableText"
      ],
      "properties": {
        "kind": {
          "const": "optional-radio-depth"
        },
        "factId": {
          "const": "spec001:FACT-SQ03-comparison"
        },
        "assetId": {
          "const": "spec001:ASSET-ILLUSTRATION-16"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "alternativeText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "unavailableText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "entryContexts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roomId",
            "safePositionId",
            "hotspotId"
          ],
          "properties": {
            "roomId": {
              "const": "spec001:R08"
            },
            "safePositionId": {
              "const": "spec001:R08.entry"
            },
            "hotspotId": {
              "const": "spec001:HOTSPOT-radio-vane"
            }
          }
        }
      ]
    },
    "returnPolicy": {
      "const": "captured-entry"
    },
    "timingDefault": {
      "const": "off"
    }
  }
}
