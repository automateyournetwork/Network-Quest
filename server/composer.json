{
    "name": "automateyournetwork/network-quest-server",
    "description": "Dedicated PHP service dependencies for Network Quest.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "~8.4.0",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-session": "*",
        "google/apiclient": "2.20.1",
        "league/oauth2-client": "2.10.0",
        "opis/json-schema": "2.6.3"
    },
    "require-dev": {
        "phpunit/phpunit": "12.5.45"
    },
    "config": {
        "allow-plugins": false,
        "platform-check": true,
        "preferred-install": "dist",
        "secure-http": true,
        "sort-packages": true,
        "store-auths": false
    }
}
