    {"id":"RETRY-THREE-CYCLES-NO-FREE-ITEMS","kind":"cycles","outcomeCaseIds":["OUT-FAILURE-RETRY","OUT-EVENT-REPLAY"],"requirements":["FR-010","AC07","SAVE06"],"inputs":{"contextRef":"failed","operation":"sequence","steps":[{"action":"retry","nextAttemptId":"attempt-b"},{"action":"apply-authored-consume-two-and-reward-once","actionId":"reward-b"},{"action":"replay-same-action","actionId":"reward-b"},{"action":"fail-then-retry","nextAttemptId":"attempt-c"},{"action":"apply-authored-consume-two-and-reward-once","actionId":"reward-c"},{"action":"fail-then-retry","nextAttemptId":"attempt-d"}]},"expected":{"steps":[{"worldRef":"preparation","repairInput":2,"repairProduct":0,"attemptReward":0,"attemptReceipt":false,"attemptId":"attempt-b","revisionGreaterThan":15},{"repairInput":0,"repairProduct":1,"attemptReward":1,"attemptReceipt":true,"attemptId":"attempt-b","revisionAdvances":true},{"repairInput":0,"repairProduct":1,"attemptReward":1,"attemptReceipt":true,"additionalAwards":0,"additionalConsumption":0},{"worldRef":"preparation","repairInput":2,"repairProduct":0,"attemptReward":0,"attemptReceipt":false,"attemptId":"attempt-c","revisionExceedsEveryEarlierStep":true},{"repairInput":0,"repairProduct":1,"attemptReward":1,"attemptReceipt":true,"attemptId":"attempt-c","revisionAdvances":true},{"worldRef":"preparation","repairInput":2,"repairProduct":0,"attemptReward":0,"attemptReceipt":false,"attemptId":"attempt-d","revisionExceedsEveryEarlierStep":true}],"journalRef":"retained-stale","newSaveWrites":0,"duplicateFactIds":0,"duplicateHintUses":0,"duplicateOutcomeEventIds":0},"independentReasoning":"Each retry restores the two consumed inputs and removes that attempt's product, reward and receipt together. Re-earning on a fresh attempt consumes them again; replay cannot credit a second reward.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RETRY-OLD-ACTION-RECEIPT","kind":"captured-work","outcomeCaseIds":["OUT-EVENT-REPLAY"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"retried","operation":"replay-captured-command","actionId":"old-reward-a","alreadyRecordedActionId":true,"expectedVersion":{"attemptId":"attempt-a","configurationRevision":8}},"expected":{"status":"rejected","reason":"stale-version","worldRef":"preparation","journalRef":"retained-stale","additionalAwards":0,"additionalConsumption":0},"independentReasoning":"A gameplay action receipt is checked only in its applicable adventure/version. It cannot make a captured pre-retry command valid or silently grant a rewound reward again.","execution":{"status":"todo","tasks":["T084","T088"]}},
    {"id":"RETRY-OLD-COMMAND-NEW-ID","kind":"captured-work","outcomeCaseIds":["OUT-EVENT-REPLAY"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"retried","operation":"replay-captured-command","actionId":"different-delivery-id","alreadyRecordedActionId":false,"expectedVersion":{"attemptId":"attempt-a","configurationRevision":16}},"expected":{"status":"rejected","reason":"stale-version","worldRef":"preparation","journalRef":"retained-stale","additionalAwards":0,"additionalConsumption":0},"independentReasoning":"Changing a delivery ID or matching the new numeric revision cannot authorize an operation captured for a different attempt; both version dimensions belong to the command precondition.","execution":{"status":"todo","tasks":["T084","T088"]}},
    {"id":"RETRY-DELAYED-MEASUREMENT","kind":"captured-work","outcomeCaseIds":["OUT-PERMANENT-PHYSICAL-STALE-ATTEMPT"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"retried","operation":"deliver-captured-measurement-command","capturedVersion":{"attemptId":"attempt-a","configurationRevision":8},"measurementId":"delayed-old-reading"},"expected":{"status":"rejected","journalRef":"retained-stale","newMeasurementEntries":0,"objectiveAwards":0},"independentReasoning":"The promise to retain measurements already observed does not authorize a delayed old-attempt callback to mutate a newer world; its captured action must fail version validation.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RETRY-REUSED-CURRENT-ATTEMPT","kind":"rejection","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"failed","operation":"retry","nextAttemptId":"attempt-a"},"expected":{"status":"rejected","reason":"attempt-reused","allStateUnchanged":true,"newSaveWrites":0},"independentReasoning":"A fresh attempt is required even when preparation and failed world already share an attempt ID. Reusing it breaks the independent attempt dimension of measurement freshness.","execution":{"status":"todo","tasks":["T084"]}},
    {"id":"RETRY-REUSED-HISTORICAL-ATTEMPT","kind":"rejection","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"failed","operation":"retry","nextAttemptId":"attempt-only-in-history","historicalAttemptReferences":["stale-measurement"]},"expected":{"status":"rejected","reason":"attempt-reused","allStateUnchanged":true,"newSaveWrites":0},"independentReasoning":"Fresh means absent from retained measurement history as well as the current world. Recycling an old ID can make previously captured activity appear to belong to the new attempt.","execution":{"status":"todo","tasks":["T084"]}},
    {"id":"RETRY-REUSED-HINT-ATTEMPT","kind":"rejection","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"failed","operation":"retry","nextAttemptId":"attempt-only-in-hints","historicalAttemptReferences":["hint-use"]},"expected":{"status":"rejected","reason":"attempt-reused","allStateUnchanged":true,"newSaveWrites":0},"independentReasoning":"Hint history retains its attempt provenance even without a measurement or outcome event. This isolates an attempt found only in assistance so an implementation cannot rely on readings alone.","execution":{"status":"todo","tasks":["T084"]}},
    {"id":"RETRY-REUSED-OUTCOME-ATTEMPT","kind":"rejection","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"failed","operation":"retry","nextAttemptId":"attempt-only-in-outcomes","historicalAttemptReferences":["outcome-event"]},"expected":{"status":"rejected","reason":"attempt-reused","allStateUnchanged":true,"newSaveWrites":0},"independentReasoning":"An earlier outcome's attempt stays distinct from a later retry even when no reading or hint records it. Outcome history is explanatory provenance and its attempt identifier cannot be recycled.","execution":{"status":"todo","tasks":["T084"]}},
    {"id":"RETRY-NO-CHECKPOINT","kind":"rejection","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","SAVE06"],"inputs":{"contextRef":"failed","operation":"retry","checkpointOverride":null},"expected":{"status":"rejected","reason":"no-preparation","allStateUnchanged":true,"newSaveWrites":0},"independentReasoning":"Recovery requires a genuine safe preparation copy. An absent checkpoint cannot be substituted with a guessed world, current terminal world or an implicit account Restore Save.","execution":{"status":"todo","tasks":["T084","T088"]}},
    {"id":"RETRY-CROSS-ADVENTURE-CHECKPOINT","kind":"rejection","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","SAVE06"],"inputs":{"contextRef":"failed","operation":"retry","checkpointAdventureId":"another-adventure"},"expected":{"status":"rejected","reason":"no-preparation","allStateUnchanged":true,"newSaveWrites":0},"independentReasoning":"Preparation belongs to its own adventure. Copying another adventure's inventory and world into the current journal would merge runs and violate the named checkpoint contract.","execution":{"status":"todo","tasks":["T084","T088"]}},
    {"id":"RETRY-UNSAFE-CHECKPOINT","kind":"rejection","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","SAVE06"],"inputs":{"contextRef":"failed","operation":"retry","checkpointSafePosition":"not-in-authored-safe-position-allowlist"},"expected":{"status":"rejected","reason":"no-preparation","allStateUnchanged":true,"newSaveWrites":0},"independentReasoning":"The preparation contract guarantees a safe return. An unrecognized position cannot certify safety, and rejection must leave the recoverable slot and current learning untouched.","execution":{"status":"todo","tasks":["T084"]}},
    {"id":"RETRY-PENDING-TRANSITION","kind":"atomicity","outcomeCaseIds":["OUT-SAVE-BLOCK-UNRESOLVED-TRANSITION","OUT-INTERRUPTED-ACCEPTANCE"],"requirements":["FR-010","FR-013","SAVE06"],"inputs":{"contextRef":"failed","operation":"retry","pendingEffectTransaction":true,"partialConsumptionCommitted":false},"expected":{"status":"rejected","allStateUnchanged":true,"partialWorldRestoration":false,"partialJournalMutation":false,"newSaveWrites":0},"independentReasoning":"An unresolved transition is not a safe recovery commit. Without an explicitly coordinated cancel/complete operation, retry must not combine a pending effect with a half-restored world.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RETRY-INTERRUPTED-BEFORE-COMMIT","kind":"atomicity","outcomeCaseIds":["OUT-INTERRUPTED-ACCEPTANCE","OUT-SAVE-BLOCK-UNRESOLVED-TRANSITION"],"requirements":["FR-010","FR-013","SAVE06"],"inputs":{"contextRef":"failed","operation":"retry","interruptAt":"after-preparing-candidate-before-install"},"expected":{"allStateUnchanged":true,"visiblePartialCandidate":false,"checkpointUnchanged":true,"newSaveWrites":0,"confirmedSlotRevision":12},"independentReasoning":"Candidate preparation is not state installation. Interruption before commit must publish no mixture of old inventory, new party, retained notes or falsely current readings.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RETRY-ATOMIC-OBSERVER","kind":"atomicity","outcomeCaseIds":["OUT-FAILURE-RETRY","OUT-INTERRUPTED-ACCEPTANCE"],"requirements":["FR-010","FR-013","SAVE06"],"inputs":{"contextRef":"failed","operation":"retry-with-observer","nextAttemptId":"attempt-b"},"expected":{"allowedWorldJournalPairs":[["attempt-end","attempt-end"],["preparation","retained-stale"]],"forbiddenPairs":[["preparation","attempt-end"],["attempt-end","retained-stale"]],"finalActivity":"safe-preparation","newSaveWrites":0},"independentReasoning":"World rollback, journal staleness and the fresh generation must be observable as one transition; a subscriber or queued autosave must never capture an intermediate mixed state.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RETRY-REVISION-EXHAUSTED","kind":"generation","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","SAVE06"],"inputs":{"contextRef":"failed","operation":"retry","highestPriorRevision":2147483647,"nextAttemptId":"attempt-b"},"expected":{"status":"rejected","reason":"generation-exhausted","allStateUnchanged":true,"attemptIdReserved":false,"revisionWraps":false,"newSaveWrites":0},"independentReasoning":"The accepted save schema bounds configuration revision at 2147483647. There is no legal larger value at this boundary, so atomic rejection is required instead of wrapping or mutating first.","execution":{"status":"todo","tasks":["T084"]}},
    {"id":"RETRY-DIRTY-GENERATION-EXHAUSTED","kind":"generation","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","SAVE06"],"inputs":{"contextRef":"failed","operation":"retry","dirtyGeneration":9007199254740991,"nextAttemptId":"attempt-b"},"expected":{"status":"rejected","reason":"generation-exhausted","allStateUnchanged":true,"attemptIdReserved":false,"newSaveWrites":0},"independentReasoning":"The accepted dirty-generation contract uses safe integers. A changed adventure cannot advance it past the last exact integer; rejecting must not consume the next attempt ID or alter the journal.","execution":{"status":"todo","tasks":["T084"]}},
    {"id":"RETRY-LAST-LEGAL-REVISION","kind":"generation","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"failed","operation":"retry","highestPriorRevision":2147483646,"nextAttemptId":"attempt-b"},"expected":{"worldRef":"preparation","journalRef":"retained-stale","configurationRevision":2147483647,"attemptId":"attempt-b","newSaveWrites":0},"independentReasoning":"The upper bound itself is legal. With all earlier revisions below it, allocating 2147483647 preserves monotonic freshness; only a subsequent required increment is exhausted.","execution":{"status":"todo","tasks":["T084"]}},
    {"id":"RESTORE-REPLACES-WORLD-AND-JOURNAL","kind":"restore","outcomeCaseIds":["OUT-RESTORE-SAVE"],"requirements":["FR-010","AC07","SAVE06"],"inputs":{"contextRef":"retried","operation":"restore-save","storedContextRef":"saved","confirmedDiscard":true,"storedSnapshotValidated":true},"expected":{"worldRef":"saved","journalRef":"saved","version":{"attemptId":"saved-attempt","configurationRevision":2},"adventureId":"saved-adventure","activity":"stable-exploration","checkpoint":null,"mergedUnsavedFacts":false,"mergedUnsavedNotes":false,"mergedUnsavedHypotheses":false,"mergedUnsavedMap":false,"mergedUnsavedHints":false,"mergedUnsavedOutcomes":false,"warningBeforeDiscard":true,"newSaveWrites":0,"newPersistentSlots":0,"confirmedSlotRevision":12},"independentReasoning":"Restore reads the validated confirmed adventure including its own journal. The retry retention rule does not apply, and lower saved versions are legitimate because the old runtime is replaced and invalidated.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RESTORE-CANCEL-UNCHANGED","kind":"restore","outcomeCaseIds":["OUT-RESTORE-CANCEL"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"retried","operation":"restore-save","storedContextRef":"saved","confirmedDiscard":false,"choice":"cancel"},"expected":{"allStateUnchanged":true,"sessionUnchanged":true,"checkpointUnchanged":true,"confirmedSlotRevision":12,"newSaveWrites":0},"independentReasoning":"Cancel is not a partial restore. Current world, learning, pending recovery context and confirmed slot remain intact when the player declines to discard unsaved progress.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RESTORE-FETCH-FAILURE","kind":"restore","outcomeCaseIds":["OUT-RESTORE-SAVE"],"requirements":["FR-010","SAVE09"],"inputs":{"contextRef":"retried","operation":"restore-save","confirmedDiscard":true,"fetchResult":"network-failure"},"expected":{"allStateUnchanged":true,"showLoadFailure":true,"confirmedSlotRevision":12,"newSaveWrites":0},"independentReasoning":"Permission to restore does not supply a replacement snapshot. If fetching fails, the existing in-memory adventure remains usable and no slot rewrite or success message is justified.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RESTORE-INVALID-SNAPSHOT","kind":"restore","outcomeCaseIds":["OUT-RESTORE-SAVE"],"requirements":["FR-010","SAVE06"],"inputs":{"contextRef":"retried","operation":"restore-save","confirmedDiscard":true,"storedSnapshotValidated":false},"expected":{"allStateUnchanged":true,"showLoadFailure":true,"confirmedSlotRevision":12,"newSaveWrites":0},"independentReasoning":"Only a validated/migrated stored snapshot may replace current state. Failed validation must not clear learning or install a partial world before reporting the load error.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RESTORE-DEFERRED-RESPONSE","kind":"restore","outcomeCaseIds":["OUT-RESTORE-SAVE","OUT-RESTORE-CANCEL"],"requirements":["FR-010","SAVE06"],"inputs":{"contextRef":"retried","operation":"restore-save","confirmedDiscard":true,"fetchResult":"pending"},"expected":{"worldRef":"preparation","journalRef":"retained-stale","confirmedSlotRevision":12,"newSaveWrites":0,"partialSavedWorldVisible":false},"independentReasoning":"Waiting for a read response cannot itself install the saved world or erase the current journal. Atomic replacement begins only after a complete validated snapshot is available.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RESTORE-OLD-CALLBACK-SAME-VERSION","kind":"captured-work","outcomeCaseIds":["OUT-RESTORE-SAVE","OUT-EVENT-REPLAY"],"requirements":["FR-010","SAVE06"],"inputs":{"contextRef":"retried","operation":"restore-then-deliver-old-ui-action","storedAdventureId":"adventure-a","storedVersion":{"attemptId":"attempt-b","configurationRevision":16},"capturedAdventureId":"adventure-a","capturedVersion":{"attemptId":"attempt-b","configurationRevision":16},"capturedRuntimeIdentity":"before-restore","currentRuntimeIdentity":"after-restore"},"expected":{"oldCallbackAccepted":false,"additionalAwards":0,"newSaveWrites":0,"loadedSnapshotUnchanged":true},"independentReasoning":"Matching versions alone do not identify a replaced runtime. Restore invalidates captured operation context even for the same saved adventure and numerical version, as required by the accepted snapshot coordinator contract.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RESTORE-REBUILD-PREPARATION-ON-ENTRY","kind":"restore","outcomeCaseIds":["OUT-RESTORE-SAVE"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"saved","operation":"enter-encounter-preparation","oldPreRestoreCheckpointAvailable":false},"expected":{"checkpointSource":"current-restored-adventure-safe-world","reusedPreRestoreCheckpoint":false,"checkpointPersisted":false,"newPersistentSlots":0,"newSaveWrites":0},"independentReasoning":"The saved payload has no hidden checkpoint. Re-entering an encounter constructs its preparation from the restored adventure, never a discarded runtime or a separate durable slot.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RETRY-GUEST-IN-MEMORY","kind":"persistence","outcomeCaseIds":["OUT-FATAL-GUEST"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"failed","operation":"retry","auth":"guest","nextAttemptId":"attempt-b"},"expected":{"worldRef":"preparation","journalRef":"retained-stale","activity":"safe-preparation","requiresSignIn":false,"newSaveWrites":0,"newPersistentSlots":0},"independentReasoning":"Guests receive the same temporary encounter recovery and learning retention without an account. In-memory recovery does not create offline durability or any server save slot.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RESTORE-GUEST-REQUIRES-SIGNIN","kind":"persistence","outcomeCaseIds":["OUT-FATAL-GUEST"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"failed","operation":"restore-save","auth":"guest","checkpointAvailable":true},"expected":{"restoreAvailable":false,"requiresSignIn":true,"checkpointUsedAsAccountSave":false,"allStateUnchanged":true,"newSaveWrites":0},"independentReasoning":"A guest checkpoint does not prove access to an account save. Restore is unavailable until sign-in; the recovery UI must not relabel temporary memory as a persistent saved adventure.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RETRY-LATER-MANUAL-SAVE","kind":"persistence","outcomeCaseIds":["OUT-E03-AFTER-CONTINUE-SAVE"],"requirements":["FR-010","FR-013","SAVE06"],"inputs":{"contextRef":"e03-continued","operation":"ordinary-manual-save","auth":"authenticated","sameAdventureSlot":true,"ifMatch":"save-12","requestId":"new-safe-manual-request","saveAcknowledged":true},"expected":{"savedWorldRef":"preparation","savedJournalRef":"shutdown-retained","savedVersion":{"attemptId":"attempt-b","configurationRevision":16},"safeState":"safe-preparation","newSaveWrites":1,"confirmedSlotRevision":13,"logicalSlotCount":1,"checkpointInPayload":false,"shutdownWorldInPayload":false},"independentReasoning":"Retained E03 history and learning can become durable only through an ordinary acknowledged safe write. The snapshot contains preparation plus stale journal, not the shutdown world or checkpoint.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RETRY-LATER-OPTIN-AUTOSAVE","kind":"persistence","outcomeCaseIds":["OUT-E03-AFTER-CONTINUE-SAVE"],"requirements":["FR-010","FR-013","SAVE06"],"inputs":{"contextRef":"e03-continued","operation":"separate-safe-preparation-autosave-event","auth":"authenticated","autosaveEnabled":true,"sameAdventureSlot":true,"saveAcknowledged":true},"expected":{"savedWorldRef":"preparation","savedJournalRef":"shutdown-retained","newSaveWrites":1,"confirmedSlotRevision":13,"logicalSlotCount":1,"checkpointInPayload":false,"shutdownWorldInPayload":false},"independentReasoning":"Opt-in autosave may subsequently capture the stable safe preparation boundary under existing same-slot rules. This is an explicit separate save-policy event, not an implicit write inside retry.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RETRY-AUTOSAVE-OFF","kind":"persistence","outcomeCaseIds":["OUT-E03-AFTER-CONTINUE-SAVE"],"requirements":["FR-010","FR-013","SAVE06"],"inputs":{"contextRef":"retried","operation":"safe-preparation-event","autosaveEnabled":false},"expected":{"newSaveWrites":0,"confirmedSlotRevision":12,"retainedLearningDurable":false,"showUnsaved":true},"independentReasoning":"Safe state is necessary but not consent. Without explicit account opt-in or a manual save request, retained learning remains in memory and the UI must not call it saved.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RETRY-UNSAFE-AUTOSAVE-RACE","kind":"persistence","outcomeCaseIds":["OUT-SAVE-BLOCK-TERMINAL-FAILURE","OUT-SAVE-BLOCK-SHUTDOWN","OUT-SAVE-BLOCK-UNRESOLVED-TRANSITION"],"requirements":["FR-010","FR-013","SAVE06"],"inputs":{"contextRef":"shutdown","operation":"queued-autosave-during-recovery","autosaveEnabled":true,"eligibleSafeEventDispatchedAfterRecovery":false},"expected":{"terminalSnapshotWrites":0,"partialSnapshotWrites":0,"newSaveWrites":0,"confirmedSlotRevision":12},"independentReasoning":"An old queued event cannot capture shutdown or an incomplete rollback. A later ordinary safe event is separately governed; recovery itself does not silently replace the recoverable slot.","execution":{"status":"todo","tasks":["T084","T088","T089"]}},
    {"id":"RETRY-SAFE-SAVE-CONFLICT","kind":"persistence","outcomeCaseIds":["OUT-E03-AFTER-CONTINUE-SAVE"],"requirements":["FR-010","FR-013","SAVE07"],"inputs":{"contextRef":"retried","operation":"ordinary-manual-save","ifMatch":"save-12","serverCurrentRevision":13,"saveResult":"precondition-failed"},"expected":{"worldRef":"preparation","journalRef":"retained-stale","newSaveWrites":0,"serverCurrentRevision":13,"showConflict":true,"retainedLearningDurable":false,"automaticMerge":false},"independentReasoning":"Retry grants no exception to concurrency control. A later conflicting save leaves retained learning in memory, preserves the other confirmed revision and requires the normal explicit resolution.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RETRY-EARLIER-SAVE-ACK","kind":"persistence","outcomeCaseIds":["OUT-FAILURE-RETRY"],"requirements":["FR-010","FR-013","SAVE09"],"inputs":{"contextRef":"retried","operation":"receive-earlier-save-acknowledgement","capturedDirtyGeneration":19,"currentDirtyGeneration":21,"committedRevision":12,"serverCurrentRevision":13,"receiptMatchesExactEarlierRequest":true},"expected":{"matchingReceiptAcknowledged":true,"marksCurrentRetrySaved":false,"currentDirtyGeneration":21,"newSaveWrites":0,"worldRef":"preparation","journalRef":"retained-stale","mustReconcileCurrentSlot":true},"independentReasoning":"Gameplay action receipts are not durable save receipts. A retained exact save acknowledgement remains valid even when older than the server slot, but it cannot mark newer retry learning as saved.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RETRY-LOGOUT-CANCEL","kind":"persistence","outcomeCaseIds":["OUT-E03-AFTER-CONTINUE-SAVE"],"requirements":["FR-010","SAVE13"],"inputs":{"contextRef":"retried","operation":"logout","choice":"cancel"},"expected":{"allStateUnchanged":true,"sessionUnchanged":true,"checkpointUnchanged":true,"newSaveWrites":0,"confirmedSlotRevision":12},"independentReasoning":"The accepted logout clarification applies after retry too: cancel preserves unsaved retained learning, the preparation checkpoint and the same signed-in session without any save.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RETRY-LOGOUT-CONFIRMED","kind":"persistence","outcomeCaseIds":["OUT-E03-AFTER-CONTINUE-SAVE"],"requirements":["FR-010","SAVE13"],"inputs":{"contextRef":"retried","operation":"logout","choice":"confirm","serverLogoutConfirmed":true,"queuedAutosave":true},"expected":{"game":null,"checkpoint":null,"notebook":null,"screen":"title","queuedAutosaveCanceled":true,"newSaveWrites":0,"confirmedSlotRevision":12,"retainedLearningDurable":false},"independentReasoning":"Confirmed logout clears unsaved retained learning and checkpoint memory, stops queued writes and returns to title. It neither saves that learning nor deletes or rewinds the confirmed slot.","execution":{"status":"todo","tasks":["T088","T089"]}},
    {"id":"RETRY-CHOICE-CANCEL","kind":"rollback","outcomeCaseIds":["OUT-FAILURE-RETRY","OUT-RESTORE-CANCEL"],"requirements":["FR-010","AC07"],"inputs":{"contextRef":"failed","operation":"recovery-choice","choice":"cancel"},"expected":{"allStateUnchanged":true,"checkpointUnchanged":true,"newSaveWrites":0,"confirmedSlotRevision":12},"independentReasoning":"Dismissing a recovery choice before committing Retry or Restore is not authorization to mutate either world or journal. The player can still choose an appropriate recovery afterward.","execution":{"status":"todo","tasks":["T088","T089"]}}
